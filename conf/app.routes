# microservice specific routes

GET        /thread-reference/:threadId  uk.gov.hmrc.sdecthreadinfoapialpha.controllers.ThreadReferenceController.getThreadReference(threadId: String)

GET        /threads        uk.gov.hmrc.sdecthreadinfoapialpha.controllers.ThreadSummaryController.getAll()

POST       /thread-create  uk.gov.hmrc.sdecthreadinfoapialpha.controllers.ThreadCreateController.createThread()

GET        /teams/by-role/:role    uk.gov.hmrc.sdecthreadinfoapialpha.controllers.TeamsController.getTeamByRole(role: String)
GET        /teams/:teamId      uk.gov.hmrc.sdecthreadinfoapialpha.controllers.TeamsController.getTeam(teamId: String)